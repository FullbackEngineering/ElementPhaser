{
  "name": "element-grinder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Element Grinder — Phaser 3 hypercasual mobile web game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:icons": "node scripts/gen-icons.mjs",
    "smoke": "node scripts/smoke.mjs http://localhost:5173/?canvas .smoke",
    "build:gametegra": "tsc --noEmit && vite build --mode gametegra"
  },
  "dependencies": {
    "@gametegra/sdk": "^0.3.8",
    "phaser": "^3.80.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^4.1.10"
  }
}
